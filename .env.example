# کپی کنید به .env.local (محلی) یا در Vercel > Settings > Environment Variables ست کنید.
# اگر ست نشوند، مقدار src/config.js استفاده می‌شود.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_KEY=YOUR-ANON-PUBLIC-KEY

# ---- اعلان پوش (اختیاری) ----
# کلیدها را با این دستور بسازید:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
# فقط روی Vercel (سرور) ست شوند، نه در کد:
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# SUPABASE_SERVICE_KEY=   (Supabase > Project Settings > API > service_role — محرمانه)
# WEBHOOK_SECRET=         (یک رشته‌ی تصادفی بلند)
# CRON_SECRET=            (یک رشته‌ی تصادفی بلند؛ Vercel آن را خودکار برای cron می‌فرستد)
